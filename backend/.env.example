# Copy to backend/.env and fill in. Never commit the real .env.
PORT=5050
NODE_ENV=production
# Public https address of this dashboard (Instagram/Threads/WhatsApp/TikTok fetch card images from here)
PUBLIC_URL=https://dashboard.example.com
# Comma-separated allowed browser origins (empty = same origin only setups / any in dev)
CORS_ORIGINS=

# Long random strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Encrypts all API tokens/passwords in the DB. Keep it safe: changing it makes saved tokens unreadable.
APP_KEY=
# Secret for the cPanel cron URL: /api/cron/<CRON_KEY>
CRON_KEY=
# Set to 1 if only the cPanel cron should drive background jobs
DISABLE_INTERNAL_CRON=0

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=dnb_dashbaord

# First admin account (created only when the users table is empty)
ADMIN_EMAIL=admin@dnb.com
ADMIN_PASSWORD=change-me-now
